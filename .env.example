# ==========================================
# SKILLGAP.AI - Environment Variables Guide
# ==========================================

# 1. Database (PostgreSQL Cloud e.g., Supabase / Neon / Railway)
DATABASE_URL=postgresql://postgres:yourpassword@db.xxxxxx.supabase.co:5432/postgres

# 2. Next.js Frontend URL (Untuk koneksi ke API FastAPI di Cloud)
# Di Vercel, isi dengan URL Backend FastAPI Anda (misal https://skillgap-backend.railway.app)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# 3. CORS Backend FastAPI (Opsional jika ingin membatasi domain web production)
# Contoh: https://skillgap-ai.vercel.app,http://localhost:3000
CORS_ORIGINS=https://skillgap-ai.vercel.app,http://localhost:3000,http://localhost:3001
