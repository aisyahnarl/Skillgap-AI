# ========================================================
# SKILLGAP.AI — Comprehensive Environment Variables Guide
# Gunakan berkas ini sebagai acuan konfigurasi lokal (.env)
# CATATAN: JANGAN PERNAH COMMIT KUNCI ASLI KE VERSION CONTROL
# ========================================================

# 1. DATABASE (PostgreSQL Cloud e.g., Supabase / Neon / Railway / Local)
DATABASE_URL=postgresql://postgres:yourpassword@db.xxxxxx.supabase.co:5432/postgres

# 2. KEAMANAN & OTENTIKASI (JWT HMAC-SHA256)
# Wajib diisi string acak minimal 32 karakter di production
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_random_string

# 3. KECERDASAN BUATAN / LLM (Google Gemini & OpenAI)
# Dapatkan Gemini API Key dari: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Opsional / Alternatif penyedia LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 4. PENYIMPANAN CLOUD DOKUMEN / CV (Vercel Blob Storage)
# Dapatkan dari dashboard Vercel Storage -> Blob
BLOB_READ_WRITE_TOKEN=

# 5. NOTIFIKASI EMAIL TRANSAKSIONAL (SMTP Service)
# Contoh penyedia: Gmail SMTP, Brevo, SendGrid, Mailgun
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifikasi@skillgap.ai
SMTP_PASS=
SMTP_FROM="SkillGap.AI Team <no-reply@skillgap.ai>"

# 6. INTEGRASI LOWONGAN KERJA LIVE (RapidAPI JSearch / LinkedIn / Jooble)
RAPIDAPI_KEY=

# 7. FRONTEND & CORS (Next.js & FastAPI)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=https://skillgap-ai.vercel.app,http://localhost:3000,http://localhost:3001
